#!/usr/bin/env bash
set -Eeuo pipefail

SESSION="${SESSION:-hermes}"
WINDOW="${WINDOW:-main}"
PROJECT="${1:-$PWD}"
PROJECT="$(cd "$PROJECT" && pwd)"

HOST="${HOST:-127.0.0.1}"
PORT="${PORT:-9119}"

VPS_IP="${VPS_IP:-$(curl -fsS https://api.ipify.org 2>/dev/null || hostname -I | awk '{print $1}')}"
SSH_TARGET="${SSH_TARGET:-root@${VPS_IP}}"
SSH_TUNNEL_CMD="ssh -L ${PORT}:127.0.0.1:${PORT} ${SSH_TARGET}"

command -v tmux >/dev/null 2>&1 || {
  echo "tmux is not installed."
  exit 1
}

# Clean old dashboard BEFORE creating tmux layout
if command -v hermes >/dev/null 2>&1; then
  hermes dashboard --stop >/dev/null 2>&1 || true
fi

attach_session() {
  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$SESSION"
  else
    tmux attach-session -t "$SESSION"
  fi
}

if tmux has-session -t "$SESSION" 2>/dev/null; then
  attach_session
  exit 0
fi

escape_single_quotes() {
  printf "%s" "$1" | sed "s/'/'\\\\''/g"
}

pane_cmd() {
  local body
  body="$(escape_single_quotes "$1")"
  printf "bash -lc '%s; printf \"\\n\\n[exited] shell ready\\n\"; exec bash -l'" "$body"
}

GIT_RUN="${GIT_RUN:-if git -C \"$PROJECT\" rev-parse --is-inside-work-tree >/dev/null 2>&1; then cd \"$PROJECT\" && lazygit; else echo \"Not in a git repository.\"; echo \"Run: hermesdash /path/to/git/repo\"; fi}"

FILES_RUN="${FILES_RUN:-if command -v yazi >/dev/null 2>&1; then yazi; elif command -v nvim >/dev/null 2>&1; then nvim .; else ls -la; fi}"

HERMES_RUN="${HERMES_RUN:-if command -v hermes >/dev/null 2>&1; then hermes chat --tui || hermes; else echo \"Hermes not found.\"; fi}"

DASHBOARD_RUN="${DASHBOARD_RUN:-if command -v hermes >/dev/null 2>&1; then
  clear;
  echo \"Starting Hermes dashboard with Chat tab enabled...\";
  echo;
  echo \"COPY THIS ON YOUR PC:\";
  echo;
  echo \"${SSH_TUNNEL_CMD}\";
  echo;
  echo \"Then open:\";
  echo;
  echo \"http://127.0.0.1:${PORT}\";
  echo;
  echo \"Server output:\";
  echo;

  HERMES_DASHBOARD_TUI=1 hermes dashboard --tui --host ${HOST} --port ${PORT} --no-open;
else
  echo \"Hermes not found. Cannot start dashboard.\";
fi}"

TERMINAL_RUN="${TERMINAL_RUN:-bash -l}"

git_pane="$(
  tmux new-session -d \
    -s "$SESSION" \
    -n "$WINDOW" \
    -c "$PROJECT" \
    -P -F "#{pane_id}" \
    "$(pane_cmd "$GIT_RUN")"
)"

hermes_pane="$(
  tmux split-window -h \
    -t "$git_pane" \
    -c "$PROJECT" \
    -P -F "#{pane_id}" \
    "$(pane_cmd "$HERMES_RUN")"
)"

dashboard_pane="$(
  tmux split-window -h \
    -t "$hermes_pane" \
    -c "$PROJECT" \
    -P -F "#{pane_id}" \
    "$(pane_cmd "$DASHBOARD_RUN")"
)"

files_pane="$(
  tmux split-window -v \
    -t "$git_pane" \
    -c "$PROJECT" \
    -P -F "#{pane_id}" \
    "$(pane_cmd "$FILES_RUN")"
)"

terminal_pane="$(
  tmux split-window -v \
    -t "$dashboard_pane" \
    -c "$PROJECT" \
    -P -F "#{pane_id}" \
    "$(pane_cmd "$TERMINAL_RUN")"
)"

tmux set-option -t "$SESSION" status off
tmux set-option -t "$SESSION" mouse on

tmux set-window-option -t "$SESSION:$WINDOW" pane-border-status top
tmux set-window-option -t "$SESSION:$WINDOW" pane-border-style "fg=colour248"
tmux set-window-option -t "$SESSION:$WINDOW" pane-active-border-style "fg=colour46,bold"
tmux set-window-option -t "$SESSION:$WINDOW" pane-border-format '#[fg=#{?pane_active,colour46,colour248},bold] #T #[fg=#{?pane_active,colour46,colour248}]━━━━━━━━━━━━━━━━ '
tmux set-window-option -t "$SESSION:$WINDOW" pane-border-lines heavy 2>/dev/null || true
tmux set-window-option -t "$SESSION:$WINDOW" mode-style "fg=colour255,bg=colour24"

tmux select-pane -t "$git_pane" -T "git"
tmux select-pane -t "$files_pane" -T "files"
tmux select-pane -t "$hermes_pane" -T "hermes chat"
tmux select-pane -t "$dashboard_pane" -T "dashboard server"
tmux select-pane -t "$terminal_pane" -T "terminal"

tmux resize-pane -t "$git_pane" -x 46 || true
tmux resize-pane -t "$dashboard_pane" -x 58 || true
tmux resize-pane -t "$git_pane" -y 20 || true
tmux resize-pane -t "$dashboard_pane" -y 18 || true

tmux select-pane -t "$hermes_pane"

attach_session
