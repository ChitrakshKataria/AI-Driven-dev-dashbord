set -e

echo "========================================"
echo " Installing Devdash prerequisites"
echo "========================================"

# Linux / WSL base dependencies
if [ "$(uname -s)" = "Linux" ]; then
    sudo apt-get update
    sudo apt-get install -y build-essential procps curl file git ca-certificates
fi

# Install Homebrew if missing
if ! command -v brew >/dev/null 2>&1; then
    echo ""
    echo "Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Load Homebrew into the current shell
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

echo ""
echo "Installing Git, tmux, lazygit and yazi..."
brew update
brew install git tmux lazygit yazi

echo ""
echo "Installing OpenAI Codex CLI..."
curl -fsSL https://chatgpt.com/codex/install.sh | sh

echo ""
echo "Installing Claude Code..."
curl -fsSL https://claude.ai/install.sh | bash

# Make sure user-installed CLIs are visible
export PATH="$HOME/.local/bin:$PATH"

if ! grep -q 'HOME/.local/bin' "$HOME/.profile" 2>/dev/null; then
    echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$HOME/.profile"
fi

echo ""
echo "Downloading Devdash..."

REPO="$HOME/AI-Driven-vibecoding-dev-dashbord"

if [ ! -d "$REPO/.git" ]; then
    git clone https://github.com/ChitrakshKataria/AI-Driven-vibecoding-dev-dashbord.git "$REPO"
else
    echo "Repository already downloaded at:"
    echo "$REPO"
fi

cd "$REPO"

chmod +x devdash
chmod +x hermesdash

echo ""
echo "Installing devdash and hermesdash globally..."

sudo mkdir -p /usr/local/bin
sudo install -m 755 ./devdash /usr/local/bin/devdash
sudo install -m 755 ./hermesdash /usr/local/bin/hermesdash

echo ""
echo "========================================"
echo " Installation complete"
echo "========================================"
echo ""

for cmd in git tmux lazygit yazi codex claude devdash hermesdash; do
    if command -v "$cmd" >/dev/null 2>&1; then
        echo "✓ $cmd"
    else
        echo "✗ $cmd - restart your terminal if this is Codex or Claude"
    fi
done

echo ""
echo "Start Devdash with:"
echo "  devdash"
echo ""
echo "Or run it against a project:"
echo "  devdash /path/to/project"
echo ""
